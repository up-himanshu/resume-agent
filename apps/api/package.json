{
  "name": "@resume-agent/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "mcp": "tsx src/mcp/stdio.ts",
    "eval": "tsx evals/run.ts",
    "mcp:inspect": "npx -y @modelcontextprotocol/inspector@2.11.0 tsx src/mcp/stdio.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@langfuse/client": "6.0.2",
    "@langfuse/openai": "6.0.2",
    "@langfuse/otel": "6.0.2",
    "@langfuse/tracing": "6.0.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/otlp-exporter-base": "0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@resume-agent/shared": "workspace:*",
    "express": "^5.3.0",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
